{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/videos/*", "/assets/*", "*.mp4", "*.css", "*.js", "*.png", "*.svg", "*.ico", "*.webp", "*.jpg", "*.jpeg"]
  },
  "routes": [
    {
      "route": "/videos/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "Accept-Ranges": "bytes"
      }
    },
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "mimeTypes": {
    ".mp4": "video/mp4",
    ".webm": "video/webm",
    ".json": "application/json"
  }
}
