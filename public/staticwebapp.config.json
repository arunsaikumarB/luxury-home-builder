{
  "mimeTypes": {
    ".mp4": "video/mp4",
    ".webm": "video/webm"
  },
  "routes": [
    {
      "route": "/videos/*",
      "headers": {
        "cache-control": "public, max-age=604800"
      }
    },
    {
      "route": "/assets/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/videos/*", "/assets/*", "/*.{css,js,mjs,map,png,jpg,jpeg,gif,svg,webp,ico,woff,woff2,mp4,webm}"]
  }
}
